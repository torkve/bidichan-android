<?xml version="1.0" encoding="utf-8"?>
<!--
  What the app is willing to hand to another app through its FileProvider.

  One directory, holding one thing: the scannable code for a profile, written
  when the user shares it. Sharing an image means giving another app a content
  URI it can read, and this is the whole of what that URI can ever reach —
  nothing else the app stores is exposed by naming a path here.
-->
<paths>
    <cache-path name="shared-codes" path="codes/" />
</paths>
