<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asking the platform which network is underneath us, so the server's
         name is resolved there rather than through the tunnel being built (see
         Resolve.kt), and so a network change can be noticed while connected.
         An install-time permission: nothing is prompted for at runtime. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Holds the CPU awake while the tunnel is up. Without it the device
         suspends between wakeups, the core's keepalive timer stops firing, and
         the peer drops a session it has heard nothing from — so the tunnel is
         gone by the time the screen comes back on. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The tunnel keeps running while the screen is off; the system requires
         this type to be declared for a service that stays up in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_lock"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bidichan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Opens a shared profile link. The payload rides in the fragment,
                 so nothing leaves the device even if the link is opened
                 elsewhere first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bidichan" android:host="profile" />
            </intent-filter>
        </activity>

        <!-- Hands the scannable code to whichever app the user shares it with.
             An image can only cross an app boundary as a content URI, so there
             has to be a provider; this one serves the bytes out of memory and
             never touches the filesystem, because the code encodes a link that
             may carry the pre-shared key. `exported="false"` with
             `grantUriPermissions` means the only way in is the temporary grant
             riding on the share intent. -->
        <provider
            android:name=".ui.SharedCodeProvider"
            android:authorities="${applicationId}.codes"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The tunnel host. BIND_VPN_SERVICE is the fixed platform permission
             name for a service that provides the system's packet interface. -->
        <service
            android:name=".tunnel.TunnelService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the encrypted tunnel while the app is in the background." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
