<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The tunnel keeps running while the screen is off; the system requires
         this type to be declared for a service that stays up in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_lock"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bidichan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Opens a shared profile link. The payload rides in the fragment,
                 so nothing leaves the device even if the link is opened
                 elsewhere first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bidichan" android:host="profile" />
            </intent-filter>
        </activity>

        <!-- Hands the scannable code to whichever app the user shares it with.
             An image can only cross an app boundary as a content URI, and the
             receiver is granted read access to that one URI for the life of the
             share. `exported="false"` with `grantUriPermissions` is what keeps
             it to that: no other app can reach the provider uninvited. See
             res/xml/shared_files.xml for the only directory it can serve. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- The tunnel host. BIND_VPN_SERVICE is the fixed platform permission
             name for a service that provides the system's packet interface. -->
        <service
            android:name=".tunnel.TunnelService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the encrypted tunnel while the app is in the background." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
